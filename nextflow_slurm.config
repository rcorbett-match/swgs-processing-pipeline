/*
 * The following pipeline parameters specify the default params and reference genome.
 */
params {
    
    // Single or paired-end reads? (Default: Paired-End, if false then single-ended data expected)
    pairedend = false

    // Provide the input file path (fastqs)
    reads = "$baseDir/test_data/chr21_raw/**.{fastq,fq,fastq.gz,fq.gz}"
    // reads = "$baseDir/../testing_dir/test_data/raw/**_{1,2}.150bp.{fastq,fq,fastq.gz,fq.gz}"

    // Choose the reference genome
    genome = "hg38"

    // Define the binsizes for copy-number calling
    binsizes = ['50kb', '500kb']
    runqdnaseq = true
    runwisex = false

    outdir = "$baseDir/results"
    refFasta = "$baseDir/hg38.fa.gz"
    binannos = "$baseDir/data/1000genomes_PE150_bin_annotations"
    nthreads = 32
    bwaThreads = 8
    haplotypeCallerMappingQual = 20
    haplotypeCallerMinBaseQual = 20
}

process {
    executor = 'slurm'
    queue = 'upgrade'

    withName:DOWNLOAD_HG38 {
        container = 'docker://curlimages/curl:latest'
        shell = ['/bin/sh']
        cpus = 1
        memory = '8 GB'
        time = '1h'
    }
    withName:FASTQC1 {
        container = 'docker://staphb/fastqc:latest'
        cpus = 1
        memory = '8 GB'
        time = '4h'
    }
    withName:MULTIQC1 {
        container = 'docker://quay.io/biocontainers/multiqc:1.3--py35_2'
        cpus = 1
        memory = '8 GB'
        time = '1h'
    }
    withName:TRIMMOMATIC_SE {
        container = 'docker://staphb/trimmomatic:latest'
        cpus = 32
        memory = '128 GB'
        time = '4h'
    }
    withName:TRIMMOMATIC_PE {
        container = 'docker://staphb/trimmomatic:latest'
        cpus = 32
        memory = '128 GB'
        time = '4h'
    }
    withName:MINIMAP2_ALIGNMENT {
        container = 'docker://niemasd/minimap2_samtools:latest'
        cpus = 32
        memory = '128 GB'
        time = '12h'
    }
    withName:MARKDUP {
        container = 'docker://broadinstitute/picard:latest'
        cpus = 1
        memory = '64 GB'
        time = '8h'
    }
    withName:INDCOVFLAG {
        container = 'docker://niemasd/minimap2_samtools:latest'
        cpus = 32
        memory = '128 GB'
        time = '4h'
    }
    withName:FASTQC2 {
        container = 'docker://staphb/fastqc:latest'
        cpus = 1
        memory = '8 GB'
        time = '4h'
    }
    withName:MULTIQC2 {
        container = 'docker://quay.io/biocontainers/multiqc:1.3--py35_2'
        cpus = 1
        memory = '8 GB'
        time = '4h'
    }
    withName:CN_QDNA1 {
        container = 'docker://asntech/qdnaseq:v1.26.0'
        cpus = 32
        memory = '128 GB'
        time = '8h'
    }
    withName:CN_WX1 {
        container = 'docker://fauzul/wisecondorx:1.0'
    }
    
}
singularity {
    enabled = true
    autoMounts = true
    // ensure that no user libraries get mounted into the container
    process.containerOptions = "--no-home"
}